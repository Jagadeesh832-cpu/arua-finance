# =================================================================
# Arua Finance - Frontend Environment Variables Template
# Set these variables in your Vercel Project Dashboard (Settings > Environment Variables)
# =================================================================

# Production Backend API URL (from Render: https://your-backend-service.onrender.com)
VITE_SERVER_URL=https://your-arua-backend.onrender.com

# Google Gemini AI API Key (Optional client fallback: https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# SMS OTP Length (Default: 6)
VITE_OTP_LENGTH=6
