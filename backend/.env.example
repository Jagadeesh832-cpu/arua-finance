# =================================================================
# Arua Finance - Backend Environment Variables Template
# Copy this file to .env and replace placeholder values with real secrets.
# NEVER commit the actual .env file to version control.
# =================================================================

# Server Port (Render will automatically set PORT in production)
PORT=4000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://dbUser:strongPassword@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority
DBName=arua_finance

# JWT Authentication Secret Key (Generate a random 32+ char string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Frontend Application URL (for Password Reset links & CORS)
CLIENT_URL=https://your-arua-finance.vercel.app

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2Factor SMS OTP Gateway (from https://2factor.in/)
TWOFACTOR_API_KEY=your_2factor_in_api_key_here
SMS_SENDER_ID=ARUAFN
OTP_LENGTH=6

# Nodemailer Email Configuration (for Password Reset & Optional Budget Emails)
APIEMAILADDRESS=your-service-email@gmail.com
APIEMAILPASS=your-gmail-16-char-app-password


